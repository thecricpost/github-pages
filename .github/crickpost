<script>
  document.addEventListener("DOMContentLoaded", function() {
    const navLinks = document.querySelectorAll("nav a.nav-link");
    const sections = document.querySelectorAll("main section");

    function setActiveSection(targetId) {
      sections.forEach(section => {
        if(section.id === targetId) {
          section.classList.add("active");
        } else {
          section.classList.remove("active");
        }
      });
      navLinks.forEach(link => {
        if(link.getAttribute("href") === "#" + targetId) {
          link.classList.add("active");
          link.setAttribute("aria-current", "page");
          link.focus();
        } else {
          link.classList.remove("active");
          link.removeAttribute("aria-current");
        }
      });

      // Scroll to top of main content smoothly when section changes
      const main = document.querySelector("main");
      if(main){
        main.scrollIntoView({behavior:"smooth"});
      }
    }

    navLinks.forEach(link => {
      link.addEventListener("click", function(event) {
        event.preventDefault();
        const targetSectionId = this.getAttribute("href").substring(1);
        setActiveSection(targetSectionId);
        history.replaceState(null, null, "#" + targetSectionId);
      });
    });

    // Show section from URL hash or default to home
    let initialSection = "home";
    if(window.location.hash) {
      const hash = window.location.hash.substring(1);
      if([...sections].some(sec => sec.id === hash)) {
        initialSection = hash;
      }
    }
    setActiveSection(initialSection);

    // VIDEO MODAL LOGIC
    const videoModal = document.getElementById('videoModal');
    const iframeContainer = document.getElementById('iframeContainer');
    const videoCloseBtn = videoModal.querySelector('.close-button');
    const videoThumbs = document.querySelectorAll('.video-thumb');

    function openVideoModal(videoId, title) {
      if(!videoId) return;
      const embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      iframeContainer.innerHTML = `<iframe src="${embedUrl}" title="${title}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
      videoModal.classList.add('active');
      videoModal.focus();
      document.body.style.overflow = 'hidden'; // disable scroll when modal open
    }

    function closeVideoModal() {
      videoModal.classList.remove('active');
      iframeContainer.innerHTML = '';
      document.body.style.overflow = ''; // restore scroll
    }

    videoThumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        const videoId = thumb.getAttribute('data-video-id');
        const title = thumb.getAttribute('aria-label') || 'Cricket video';
        openVideoModal(videoId, title);
      });
      thumb.addEventListener('keydown', e => {
        if(e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const videoId = thumb.getAttribute('data-video-id');
          const title = thumb.getAttribute('aria-label') || 'Cricket video';
          openVideoModal(videoId, title);
        }
      });
    });

    videoCloseBtn.addEventListener('click', closeVideoModal);

    videoModal.addEventListener('click', e => {
      if(e.target === videoModal) {
        closeVideoModal();
      }
    });

    document.addEventListener('keydown', e => {
      if(e.key === 'Escape' && videoModal.classList.contains('active')) {
        closeVideoModal();
      }
    });

    // ARTICLE MODAL LOGIC
    const articleModal = document.getElementById('articleModal');
    const articleContent = document.getElementById('articleContent');
    const articleCloseBtn = articleModal.querySelector('.close-button');
    const fullArticlesContainer = document.getElementById('fullArticles');
    const newsCards = document.querySelectorAll('.news-card');

    function openArticleModal(articleId) {
      if(!articleId) return;
      const fullArticle = fullArticlesContainer.querySelector('#'+articleId);
      if(fullArticle) {
        articleContent.innerHTML = fullArticle.innerHTML;
        articleModal.classList.add('active');
        articleModal.focus();
        document.body.style.overflow = 'hidden';
      }
    }

    function closeArticleModal() {
      articleModal.classList.remove('active');
      articleContent.innerHTML = '';
      document.body.style.overflow = '';
    }

    newsCards.forEach(card => {
      card.addEventListener('click', () => {
        const articleId = card.getAttribute('data-article-id');
        openArticleModal(articleId);
      });
      card.addEventListener('keydown', (e) => {
        if(e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const articleId = card.getAttribute('data-article-id');
          openArticleModal(articleId);
        }
      });
    });

    articleCloseBtn.addEventListener('click', closeArticleModal);

    articleModal.addEventListener('click', e => {
      if(e.target === articleModal) {
        closeArticleModal();
      }
    });

    document.addEventListener('keydown', e => {
      if(e.key === 'Escape' && articleModal.classList.contains('active')) {
        closeArticleModal();
      }
    });

  });
</script>
